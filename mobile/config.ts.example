/**
 * CareerPilot Mobile — API configuration
 *
 * Single source of truth for the backend's base URL. Every API call in
 * the app should import API_BASE_URL from here instead of hardcoding it.
 *
 * IMPORTANT: "localhost" refers to the phone itself, not your computer.
 * - Physical phone via Expo Go: use your computer's LAN IP,
 *   e.g. "http://192.168.1.23:8000"
 * - Android emulator: "http://10.0.2.2:8000"
 * - iOS simulator: "http://localhost:8000" works fine
 */
export const API_BASE_URL = "http://localhost:8000";